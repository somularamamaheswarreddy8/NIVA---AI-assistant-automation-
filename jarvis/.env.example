# NIVA - Universal AI Computer Control System
# Environment Configuration Template
# Copy this file to .env and customize as needed.

# ==========================================
# Assistant Identity
# ==========================================
ASSISTANT_NAME=NIVA

# ==========================================
# AI / LLM Configuration
# ==========================================
# Available providers: gemini, openai, anthropic, ollama, local, rule_based
# If no API key is provided, NIVA automatically falls back to the trained statistical NLU engine.
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=

# Local LLM / Ollama Endpoint (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# ==========================================
# Voice & Audio Settings
# ==========================================
# Wake word to activate listening (case-insensitive)
WAKE_WORD=niva
WAKE_WORD_ENABLED=true

# Speech Recognition Engine: whisper, google, offline
STT_ENGINE=google

# Text-To-Speech Engine: pyttsx3, edge-tts
TTS_ENGINE=pyttsx3
TTS_VOICE_RATE=180
TTS_VOICE_VOLUME=1.0

# Supported natural languages: en, te-en (Telugu-English mixed)
DEFAULT_LANGUAGE=en

# ==========================================
# Automation & Safety Settings
# ==========================================
# Safe mode requires user confirmation for destructive actions (file deletion, format, purchases)
SAFE_MODE=true

# Emergency stop hotkey (global)
EMERGENCY_STOP_KEY=ctrl+alt+s

# Browser automation headless mode (true: hidden, false: visible browser window)
BROWSER_HEADLESS=false

# Screen capture resolution scale (0.5 to 1.0)
VISION_SCALE=0.75

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
